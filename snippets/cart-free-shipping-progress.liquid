{% comment %}
  Feature: Free Shipping Progress Bar
  Description: Configurable progress toward a minimum cart subtotal for free shipping (cart page only)
{% endcomment %}

{%- liquid
  assign enable = settings.enable_free_shipping_progress
  assign minimum_units = settings.free_shipping_minimum | default: 0
  assign threshold_cents = minimum_units | times: 100
  assign current_cents = cart.items_subtotal_price
-%}

{%- if enable and cart != empty and minimum_units > 0 -%}
  {%- liquid
    assign reached = false
    if current_cents >= threshold_cents
      assign reached = true
    endif

    assign pct = current_cents | times: 100 | divided_by: threshold_cents
    if pct > 100
      assign pct = 100
    endif

    assign remaining_cents = threshold_cents | minus: current_cents
    if remaining_cents < 0
      assign remaining_cents = 0
    endif

    assign amount_formatted = remaining_cents | money

    if settings.free_shipping_message_remaining != blank
      assign message_remaining = settings.free_shipping_message_remaining | replace: '{{ amount }}', amount_formatted
    else
      assign message_remaining = 'sections.cart.free_shipping.remaining_html' | t: amount: amount_formatted
    endif

    if settings.free_shipping_message_success != blank
      assign message_success = settings.free_shipping_message_success
    else
      assign message_success = 'sections.cart.free_shipping.success' | t
    endif

    assign heading_text = settings.free_shipping_heading | strip
    if heading_text == blank
      assign heading_text = 'sections.cart.free_shipping.heading_default' | t
    endif

    assign safe_id = section_id | default: 'cart' | replace: ' ', '-' | replace: '.', '-'
  -%}

  <div
    class="free-shipping-progress{% if reached %} free-shipping-progress--complete{% endif %}"
    role="region"
    aria-labelledby="free-shipping-title-{{ safe_id }}"
    data-free-shipping-progress
  >
    <h3 class="free-shipping-progress__title" id="free-shipping-title-{{ safe_id }}">
      {{ heading_text | escape }}
    </h3>

    {%- if reached -%}
      <p class="free-shipping-progress__message free-shipping-progress__message--success">
        {{ message_success | escape }}
      </p>
    {%- else -%}
      <p class="free-shipping-progress__message" id="free-shipping-desc-{{ safe_id }}">
        {{ message_remaining | escape }}
      </p>
    {%- endif -%}

    <div
      class="free-shipping-progress__track"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ pct }}"
      aria-valuetext="{{ pct }}%"
      {% unless reached %}
        aria-describedby="free-shipping-desc-{{ safe_id }}"
      {% endunless %}
    >
      <div class="free-shipping-progress__fill" style="width: {{ pct }}%;"></div>
    </div>
  </div>
{%- endif -%}
